{
  "name": "rummy-game",
  "version": "1.0.0",
  "description": "A turn-based Rummy card game using TypeScript and Bun",
  "private": true,
  "main": "src/server.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "build": "bun build src/client/game.ts --outdir public/static/js",
    "dev": "bun run build && bun run start",
    "watch": "bun build src/client/game.ts --outdir public/static/js --watch"
  },
  "dependencies": {
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.1",
    "@types/bun": "latest"
  }
}